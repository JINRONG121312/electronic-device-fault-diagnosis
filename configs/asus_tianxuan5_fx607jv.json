{
  "device_type": "laptop",
  "display_name": "ASUS Tianxuan 5 Pro / TUF Gaming F16 FX607JV",
  "version": "1.0",
  "description": "Model-calibrated FRU profile for ASUS Tianxuan 5 Pro / TUF Gaming F16 FX607JV. This profile keeps only repair-level target FRUs and merges integrated components into their serviceable modules.",
  "metadata": {
    "market_name": "ASUS Tianxuan 5 Pro",
    "official_cn_name": "ASUS Tianxuan 5 Pro Intel Edition",
    "model": "FX607JV",
    "model_family": "FX607J",
    "source_device_scan": "configs/detected_device.json",
    "official_sources": [
      "https://www.asus.com.cn/laptops/for-gaming/tuf-gaming/asus-tuf-gaming-f16-2024/techspec/",
      "https://dlcdnets.asus.com/pub/ASUS/GamingNB/FX607JI/E23104_FX607J_FA607P_SM_WEB.pdf"
    ],
    "notes": [
      "CPU, Intel integrated graphics, NVIDIA laptop GPU, LAN controller, USB controller, and Bluetooth PAN are treated as evidence sources or motherboard/subsystem evidence, not separate target FRUs.",
      "The official service manual lists service procedures for battery, M.2 SSD, RAM, WLAN, fan, heat sink, motherboard, speakers, LED board, touchpad, display panel, display bezel, and camera module."
    ]
  },
  "fru_list": [
    {
      "id": "power_adapter",
      "name": "AC Power Adapter",
      "category": "PowerFRU",
      "replaceable": true,
      "diagnosis_role": "target_fru",
      "verification_status": "official_spec",
      "description": "External ASUS power adapter. The official specification lists 240W or 280W adapter options depending on configuration.",
      "aliases": ["adapter", "charger", "power brick", "ac adapter"],
      "source_refs": ["official_techspec_power_adapter"],
      "evidence_rules": [
        {
          "id": "adapter_power_event_log",
          "evidence_type": "log_pattern",
          "source": "system_event_log",
          "pattern": "ac adapter|charging|kernel-power|power source",
          "weight": 0.5,
          "description": "Power-source or adapter-related events appear in system logs."
        },
        {
          "id": "adapter_active_test_failed",
          "evidence_type": "active_test",
          "source": "power_test",
          "pattern": "adapter_not_detected|adapter_wattage_abnormal",
          "weight": 1.0,
          "description": "Active power test reports adapter detection or wattage abnormality."
        }
      ]
    },
    {
      "id": "battery_pack",
      "name": "Battery Pack",
      "category": "PowerFRU",
      "replaceable": true,
      "diagnosis_role": "target_fru",
      "verification_status": "official_service_manual",
      "description": "Internal battery pack. The official specification lists a 90Wh 4-cell lithium-ion battery for this model family.",
      "aliases": ["battery", "bms", "power"],
      "source_refs": ["official_techspec_battery", "service_manual_battery"],
      "evidence_rules": [
        {
          "id": "battery_health_low",
          "evidence_type": "metric_threshold",
          "source": "battery_status",
          "metric": "full_charge_capacity_ratio",
          "operator": "<",
          "threshold": 0.6,
          "weight": 0.9,
          "description": "Battery full-charge capacity is far below design capacity."
        },
        {
          "id": "battery_charge_failure_log",
          "evidence_type": "log_pattern",
          "source": "system_event_log",
          "pattern": "battery|charging|acpi|kernel-power",
          "weight": 0.6,
          "description": "Battery or charging events appear in system logs."
        }
      ]
    },
    {
