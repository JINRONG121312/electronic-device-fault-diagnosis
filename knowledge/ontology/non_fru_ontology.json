      "evidence_types": ["event_log", "driver_stack", "crash_dump"]
    },
    {
      "id": "firmware_or_config_fault",
      "type": "non_fru_fault",
      "category": "firmware_or_config",
      "repair_action": "update_bios_ec_or_change_setting",
      "typical_symptoms": ["no_charge", "thermal_policy_issue", "device_disabled"],
      "evidence_types": ["BIOS_version", "ACPI_event", "policy_config"]
    },
    {
